#!/sbin/bash

linuxpart=/dev/block/by-name/linux

printf "\n==== Linux Backup Restore ====\n"
printf "Default backup path: /sdcard/linuxbackup\n"
printf "Enter custom path or press Enter to use default:\n> "
read -r p
backuppath="${p:-/sdcard/linuxbackup}"

backupfile="$backuppath/linuxbackup.tar.gz"
[ -f "$backupfile" ] || { echo "No backup found at $backupfile"; exit 1; }

[ -e "$linuxpart" ] || { echo "Linux partition not found at $linuxpart"; exit 1; }

compressedsize=$(wc -c < "$backupfile" 2>/dev/null || echo 0)
partsize=$(blockdev --getsize64 "$linuxpart" 2>/dev/null)
[ -n "$partsize" ] || { echo "Failed to get size of $linuxpart"; exit 1; }

echo "Partition size : $(awk "BEGIN {printf \"%.2f\", $partsize/1e9}") GB"
echo "Backup (compressed): $(awk "BEGIN {printf \"%.2f\", $compressedsize/1e9}") GB"

[ "$partsize" -gt "$compressedsize" ] || {
  echo "ERROR: Partition is smaller than compressed backup"
  exit 1
}

fstype=$(cat "$backuppath/linux.fstype" 2>/dev/null || echo "ext4")
echo "Detected filesystem from backup: $fstype"

umount -lf "$linuxpart" 2>/dev/null
mkdir -p /linux

case "$fstype" in
  btrfs)
    echo "Formatting as btrfs..."
    mkfs.btrfs -f -L LINUXNABU "$linuxpart" || { echo "Failed to format as btrfs"; exit 1; }
    mount -t btrfs "$linuxpart" /linux || { echo "Mount failed"; exit 1; }
    ;;
  *)
    echo "Formatting as ext4..."
    mke2fs -t ext4 -F "$linuxpart" || { echo "Failed to format as ext4"; exit 1; }
    mount -t ext4 "$linuxpart" /linux || { echo "Mount failed"; exit 1; }
    ;;
esac

echo "Restoring Linux backup..."
tar xzf "$backupfile" -C /linux || { echo "Failed to extract backup"; exit 1; }

dd if=$backuppath/esp.img of=/dev/block/by-name/esp bs=64M 2>/dev/null

umount /linux 2>/dev/null

echo "Restoration complete"
